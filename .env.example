# Copy this file to .env.local and fill in the values.

# Public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (used only for login and photo storage).
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "Publishable key" (starts with sb_publishable_). Old projects: the "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX

# Postgres connection string used by Drizzle (server only, never exposed).
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543) for Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=you@example.com

# WhatsApp number shopkeepers contact for help and upgrades (digits, with country code).
NEXT_PUBLIC_SUPPORT_WHATSAPP=91XXXXXXXXXX
